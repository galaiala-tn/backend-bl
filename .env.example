# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # server-side only, bypasses RLS
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret                  # Project Settings > API > JWT Secret

# Google Maps / Places
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Payments (Stripe used as the reference provider — swap in payments.service.ts if different)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Push notifications (FCM)
FCM_SERVER_KEY=your-fcm-server-key

# File storage (Supabase Storage bucket for invoice PDFs)
INVOICES_BUCKET=invoices
